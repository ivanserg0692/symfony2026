GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"
GIT_COMMITTER_NAME="Your Name"
GIT_COMMITTER_EMAIL="you@example.com"
COMPOSE_PROJECT_NAME="symfony2026"
COMPOSE_FILE=docker-compose.yml

# Internal infrastructure URLs
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me
PRODUCT_SEARCH_INDEX_PREFIX=products
PRODUCT_SEARCH_INDEX_ALIAS=products
PRODUCT_SEARCH_RESULT_WINDOW=10000
PRODUCT_SEARCH_BATCH_SIZE=500
PRODUCT_SEARCH_REINDEX_LOCK_ID=1633906547
PRODUCT_SEARCH_INCREMENTAL_WORKER_PAUSED=0
CATALOG_SECTIONS_CACHE_TTL_SECONDS=600

# Infrastructure versions
ELASTIC_STACK_VERSION=9.5.2

# Runtime worker and connection limits
PHP_FPM_MAX_CHILDREN=10
# auto: resolve with getconf _NPROCESSORS_ONLN at container startup.
# Set a positive integer to override both Nginx worker_processes and the keepalive calculation.
NGINX_WORKER_COUNT=auto
ROADRUNNER_NUM_WORKERS=1
POSTGRES_CONNECTION_RESERVE=20
