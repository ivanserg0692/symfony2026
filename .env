GIT_AUTHOR_NAME="Ivan Petrov"
GIT_AUTHOR_EMAIL="ivan.serg0692@gmail.com"
GIT_COMMITTER_NAME="Ivan Petrov"
GIT_COMMITTER_EMAIL="ivan.serg0692@gmail.com"
COMPOSE_PROJECT_NAME="symfony2026"
COMPOSE_FILE=docker-compose.yml

# Browser security
CSRF_TRUSTED_ORIGINS=http://localhost:3000
###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# Internal service URLs
CATALOG_GRPC_DSN=catalog-grpc:9001
CATALOG_SERVICE_BASE_URL=http://catalog-web:8000
MAIN_SERVICE_BASE_URL=http://symfony-web:8000

# Internal infrastructure URLs
ELASTICSEARCH_URL=http://elasticsearch:9200
MAILER_DSN=smtp://mailpit:1025
MINIO_ENDPOINT=http://minio:9000

# Infrastructure versions
ELASTIC_STACK_VERSION=9.5.2

# Database maintenance
DATABASE_SERVICE_TARGETS="symfony-cli:Main Symfony service,catalog-cli:Catalog service,cart-cli:Cart service"
