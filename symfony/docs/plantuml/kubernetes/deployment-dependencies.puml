@startuml
title Kubernetes deployment dependencies
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

legend top
  Rectangle: a workload, Job, or deployment script step.
  Group frame: related components and steps; arrows show their dependencies.
  <color:DarkGreen>Green: runtime Service or API check in a Pod/Job.</color>
  <color:DarkOrange>Orange: initContainer checks a Job, controller rollout, or database capacity.</color>
  <color:Purple>Purple: deployment/reindex script checks expected image + current rollout or Job completion.</color>
  <color:RoyalBlue>Blue: final k8s:verify checks expected image + current rollout or Job completion.</color>
  --> Dependency enforced by a Job or workload initContainer.
  ..> First Catalog index coordinated by the deployment script.
endlegend

package "Auth" {
  component "Auth PostgreSQL\ncurrent rollout + capacity" as AuthDb
  component "auth-migrate Job\nimage: symfony-auth:<current-tag>-<profile>\n<color:DarkOrange>init: wait-database-rollout (capacity + rollout)</color>\n<color:DarkGreen>init: wait-database (SQL capacity)</color>\n<color:RoyalBlue>image + Complete: final k8s:verify</color>" as AuthMigrate
  component "symfony-web\nimage: symfony-auth:<current-tag>-<profile>\n<color:DarkOrange>init: wait-auth-bootstrap (auth-migrate + minio-bucket-setup images + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-redis, wait-rabbitmq</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as AuthWeb
  component "auth-async-worker\nimage: symfony-auth:<current-tag>-<profile>\n<color:DarkOrange>init: wait-auth-migration (auth-migrate image + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-rabbitmq, wait-mailpit</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as AuthWorker
  component "MinIO\nimage: symfony-minio:<current-tag>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as Minio
  component "minio-bucket-setup Job\nimage: symfony-mc:<current-tag>\n<color:DarkOrange>init: wait-minio-rollout (MinIO image + rollout)</color>\n<color:DarkGreen>setup: MinIO API</color>\n<color:RoyalBlue>image + Complete: final k8s:verify</color>" as MinioSetup

  AuthDb --> AuthMigrate
  AuthMigrate --> AuthWeb
  AuthMigrate --> AuthWorker
  Minio --> MinioSetup
  MinioSetup --> AuthWeb
}

package "Catalog" {
  component "Catalog PostgreSQL\ncurrent rollout + capacity" as CatalogDb
  component "catalog-migrate Job\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-database-rollout (capacity + rollout)</color>\n<color:DarkGreen>init: wait-database (SQL capacity)</color>\n<color:RoyalBlue>image + Complete: final k8s:verify</color>" as CatalogMigrate
  component "catalog-web\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-catalog-migration (migration image + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-redis, wait-elasticsearch</color>\n<color:Purple>image + rollout: initial reindex gate</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as CatalogWeb
  component "catalog-grpc\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-catalog-migration (migration image + Complete)</color>\n<color:DarkGreen>init: wait-database</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as CatalogGrpc
  component "catalog-search-outbox-worker\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-catalog-migration (migration image + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-rabbitmq</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as CatalogOutbox
  component "catalog-search-index-worker\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-catalog-migration (migration image + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-rabbitmq, wait-elasticsearch</color>\n<color:Purple>image + rollout: reindex worker restore</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as CatalogIndex

  CatalogDb --> CatalogMigrate
  CatalogMigrate --> CatalogWeb
  CatalogMigrate --> CatalogGrpc
  CatalogMigrate --> CatalogOutbox
  CatalogMigrate --> CatalogIndex
}

package "Cart" {
  component "Cart PostgreSQL\ncurrent rollout + capacity" as CartDb
  component "cart-migrate Job\nimage: symfony-cart:<current-tag>-<profile>\n<color:DarkOrange>init: wait-database-rollout (capacity + rollout)</color>\n<color:DarkGreen>init: wait-database (SQL capacity)</color>\n<color:RoyalBlue>image + Complete: final k8s:verify</color>" as CartMigrate
  component "cart-web\nimage: symfony-cart:<current-tag>-<profile>\n<color:DarkOrange>init: wait-cart-migration (migration image + Complete)</color>\n<color:DarkGreen>init: wait-database, wait-redis</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as CartWeb

  CartDb --> CartMigrate
  CartMigrate --> CartWeb
}

component "api-gateway\nimage: symfony-api-gateway-nginx:<current-tag>\n<color:DarkGreen>init: wait-http-upstreams (Auth, Catalog, Cart HTTP Services)</color>\n<color:RoyalBlue>image + rollout: final k8s:verify</color>" as Gateway
AuthWeb --> Gateway
CatalogWeb --> Gateway
CartWeb --> Gateway

package "First Catalog index (deployment script)" {
  component "Initial reindex gate\n<color:Purple>catalog-migrate: expected image + Complete</color>\n<color:Purple>catalog-web: expected image + current rollout</color>" as ReindexGate
  component "catalog-full-reindex Job\nimage: symfony-catalog:<current-tag>-<profile>\n<color:DarkOrange>init: wait-catalog-migration (Complete only)</color>\n<color:DarkGreen>init: wait-elasticsearch</color>\n<color:Purple>script: expected image + Complete</color>" as ReindexJob
  component "Restore catalog-search-index-worker\n<color:Purple>script: expected image + current rollout</color>" as RestoreWorker

  ReindexGate ..> ReindexJob
  ReindexJob ..> RestoreWorker
}

note bottom of ReindexGate
  Runs only when catalog-initial-index is absent.
  This release-wide operation does not run in a Pod initContainer.
end note

note bottom of Gateway
  An old Ready upstream replica may answer wait-http-upstreams.
  Its response does not verify the upstream image version.
end note

note as Independent
  elasticsearch-setup waits for Elasticsearch and sets the Kibana password.
  Kibana init: wait-elasticsearch-credentials.
  Catalog workloads check Elasticsearch health, not elasticsearch-setup.
  Prometheus (symfony-prometheus:<current-tag>) and
  Grafana (symfony-grafana:<current-tag>) start independently;
  <color:RoyalBlue>final k8s:verify checks their images + rollouts.</color>
  Database exporters start independently; each init: wait-database.
end note

@enduml
