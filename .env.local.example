# Copy this file to .env.local and replace every "change-me" value.
# Keep credentials URL-safe or percent-encode them in DATABASE_URL,
# MESSENGER_TRANSPORT_DSN and MAILER_DSN.
# For Docker Compose interpolation, start the stack with:
# docker compose --env-file .env --env-file .env.local up -d

# Application runtime
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-main-app-secret

# Public application URLs and browser security
DEFAULT_URI=https://api.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://desktop-s6v2euu:3000,http://desktop-s6v2euu:8001
# Browser origins allowed to call the APIs from this workstation.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|desktop-s6v2euu)(:[0-9]+)?$'

# Main PostgreSQL database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-main-db-password
DATABASE_URL='postgresql://app:change-me-main-db-password@database:5432/app?serverVersion=16&charset=utf8'

# Catalog service and its PostgreSQL database
CATALOG_APP_SECRET=change-me-catalog-app-secret
CATALOG_POSTGRES_DB=catalog
CATALOG_POSTGRES_USER=catalog
CATALOG_POSTGRES_PASSWORD=change-me-catalog-db-password
CATALOG_DATABASE_URL='postgresql://catalog:change-me-catalog-db-password@catalog-db:5432/catalog?serverVersion=16&charset=utf8'
CATALOG_PAGINATION_USE_HAS_NEXT_PAGE=0

# Cart service and its PostgreSQL database
CART_APP_SECRET=change-me-cart-app-secret
CART_POSTGRES_DB=cart
CART_POSTGRES_USER=cart
CART_POSTGRES_PASSWORD=change-me-cart-db-password
CART_DATABASE_URL='postgresql://cart:change-me-cart-db-password@cart-db:5432/cart?serverVersion=16&charset=utf8'

# Initial administrator account used by app:admin:sync
APP_ADMIN_LOGIN=admin@example.com
APP_ADMIN_PASSWORD=change-me-admin-password

# JWT (generate the key pair separately with symfony/bin/init-jwt)
JWT_PASSPHRASE=change-me-jwt-passphrase
JWT_REFRESH_TTL=2592000

# Cloudflare Turnstile
TURNSTILE_KEY=change-me-turnstile-site-key
TURNSTILE_SECRET=change-me-turnstile-secret-key

# RabbitMQ and Symfony Messenger
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
MESSENGER_TRANSPORT_DSN=amqp://app:change-me-rabbitmq-password@rabbitmq:5672/%2f/messages

# Outgoing email
MAILER_DSN=smtp://user:change-me-mailer-password@smtp.example.com:587
MAILER_FROM=no-reply@example.com

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=app
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=app

# Local Elastic Stack credentials
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me

# Optional deployment overrides
API_GATEWAY_HTTP_PORT=8001
XDEBUG_MODE=off
